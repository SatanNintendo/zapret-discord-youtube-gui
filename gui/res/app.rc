// Zapret GUI — app.rc
// icon + embedded manifest + version info

#include <winver.h>

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName",      "Zapret GUI"
            VALUE "FileDescription",  "Zapret GUI - Discord & YouTube bypass control"
            VALUE "FileVersion",      "1.0 (build 1.10.4)"
            VALUE "ProductVersion",   "1.0 (build 1.10.4)"
            VALUE "OriginalFilename", "ZapretGUI.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
